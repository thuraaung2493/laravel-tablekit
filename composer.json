{
    "name": "thuraaung/tablekit",
    "description": "Laravel-first server-side tables with version-aware DataTables adapters.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "illuminate/support": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^5.0 || ^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Thuraaung\\TableKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thuraaung\\TableKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thuraaung\\TableKit\\TableKitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "@php scripts/lint.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/node_modules",
            "/.compat",
            "/tests",
            "/scripts",
            "/demo",
            "/.github",
            "/test-results",
            "/playwright-report",
            "/composer.lock",
            "/package-lock.json",
            "/phpunit.xml",
            "/playwright.config.cjs",
            "/.phpunit.result.cache",
            "/.phpunit.cache"
        ]
    },
    "homepage": "https://github.com/thuraaung2493/laravel-tablekit",
    "support": {
        "issues": "https://github.com/thuraaung2493/laravel-tablekit/issues",
        "source": "https://github.com/thuraaung2493/laravel-tablekit"
    }
}
